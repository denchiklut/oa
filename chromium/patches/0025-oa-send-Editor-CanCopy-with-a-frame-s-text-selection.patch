--- a/third_party/blink/renderer/core/testing/fake_local_frame_host.h
+++ b/third_party/blink/renderer/core/testing/fake_local_frame_host.h
@@ -122,7 +122,8 @@ class FakeLocalFrameHost : public mojom::blink::LocalFrameHost {
                              mojom::blink::DOMNodeIdPtr dom_node_id) override;
   void TextSelectionChanged(const String& text,
                             uint32_t offset,
-                            const gfx::Range& range) override;
+                            const gfx::Range& range,
+                            bool can_copy) override;
   void ShowPopupMenu(
       mojo::PendingRemote<mojom::blink::PopupMenuClient> popup_client,
       const gfx::Rect& bounds,
