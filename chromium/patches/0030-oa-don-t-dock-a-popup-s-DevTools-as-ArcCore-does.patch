From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denchiklut <ollylut@gmail.com>
Date: Wed, 25 Nov 2026 13:44:11 -0700
Subject: [PATCH] oa: don't dock a popup's DevTools, as ArcCore does

---
 chrome/browser/devtools/devtools_window.cc | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/devtools/devtools_window.cc b/chrome/browser/devtools/devtools_window.cc
index 1998350c3ef994cbb1509a05e8f46a679dedab5d..dcc8778c24bc28be8a43d69ddeb91f8ee97ef798 100644
--- a/chrome/browser/devtools/devtools_window.cc
+++ b/chrome/browser/devtools/devtools_window.cc
@@ -1494,9 +1494,11 @@ DevToolsWindow* DevToolsWindow::Create(
   }
 
   SessionID inspected_browser_session_id = SessionID::InvalidValue();
+  bool frontend_can_dock = can_dock;
 #if BUILDFLAG(IS_ANDROID)
   // Docking is not supported yet.
   can_dock = false;
+  frontend_can_dock = false;
 #else
   if (inspected_web_contents) {
     // Check for a place to dock.
@@ -1510,17 +1512,24 @@ DevToolsWindow* DevToolsWindow::Create(
 #endif  // BUILDFLAG(IS_MAC)
     DevtoolsUIController* devtools_ui_controller =
         browser ? DevtoolsUIController::From(browser) : nullptr;
-    if (!Embedder::FromWebContents(inspected_web_contents) &&
-        (!devtools_ui_controller ||
-                        !devtools_ui_controller->CanDockDevtools())) {
+    if (Embedder::FromWebContents(inspected_web_contents)) {
+      // An embedder docks DevTools itself, so the window stays dockable. As
+      // in ArcCore, upstream's rule stands for the frontend: it can't dock in
+      // a popup, and asks the embedder for a window of its own.
+      frontend_can_dock =
+          browser && browser->GetType() != BrowserWindowInterface::TYPE_POPUP;
+    } else if (!devtools_ui_controller ||
+               !devtools_ui_controller->CanDockDevtools()) {
       can_dock = false;
+      frontend_can_dock = false;
     }
   }
 #endif  // !BUILDFLAG(IS_ANDROID)
 
   // Create WebContents with devtools.
-  GURL url(GetDevToolsURL(profile, frontend_type, frontend_url, can_dock, panel,
-                          has_other_clients, browser_connection));
+  GURL url(GetDevToolsURL(profile, frontend_type, frontend_url,
+                          frontend_can_dock, panel, has_other_clients,
+                          browser_connection));
   std::unique_ptr<WebContents> main_web_contents =
       WebContents::Create(WebContents::CreateParams(profile));
   main_web_contents->GetController().LoadURL(
