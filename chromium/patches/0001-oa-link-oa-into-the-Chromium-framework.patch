From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denchiklut <ollylut@gmail.com>
Date: Wed, 4 Nov 2026 00:54:36 -0700
Subject: [PATCH] oa: link //oa into the Chromium framework

Adds //oa to the framework's dependencies and exports OACoreMain, the entry point the Oa app calls instead of ChromeMain.
---
 chrome/BUILD.gn              | 1 +
 chrome/app/framework.exports | 1 +
 chrome/app/framework.order   | 3 +++
 3 files changed, 5 insertions(+)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index f1d133b6cda978b105c6110b279fdd75a1b2f061..7fdaf0ad4e0468b44623467b8ba009c475d4a234 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1341,6 +1341,7 @@ if (is_win) {
       "//components/policy:generated",
       "//components/webapps/isolated_web_apps:scheme",
       "//content/public/app",
+      "//oa",
       "//third_party/cld_3/src/src:cld_3",
     ]
 
diff --git a/chrome/app/framework.exports b/chrome/app/framework.exports
index 37c881f5d29511347ce508ce7bfb1f54cb37a120..389fbbaa5f53e62c44c4b968ad72992348fc4c7b 100644
--- a/chrome/app/framework.exports
+++ b/chrome/app/framework.exports
@@ -19,3 +19,4 @@
 _ChromeAppModeStart_v8
 _ChromeMain
 _ChromeWebAppShortcutCopierMain
+_OACoreMain
diff --git a/chrome/app/framework.order b/chrome/app/framework.order
index 6dbc3aeff3f8b61285d4324fcb0eee6dcfe1b6ca..1ef6d92987c7fb492e23bc41911767a8bf18bb34 100644
--- a/chrome/app/framework.order
+++ b/chrome/app/framework.order
@@ -29,5 +29,8 @@ _ChromeAppModeStart_v8
 # Entry point for the web app shortcut copier.
 _ChromeWebAppShortcutCopierMain
 
+# Entry point for the Oa app.
+_OACoreMain
+
 # _ChromeMain must be listed last.  That's the whole point of this file.
 _ChromeMain
