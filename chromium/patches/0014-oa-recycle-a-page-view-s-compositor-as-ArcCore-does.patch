+////////////////////////////////////////////////////////////////////////////////
+// RecyclableCompositorMacFactory
+
+// static
+RecyclableCompositorMacFactory* RecyclableCompositorMacFactory::Get() {
+  static base::NoDestructor<RecyclableCompositorMacFactory> factory;
+  return factory.get();
+}
+
+RecyclableCompositorMacFactory::RecyclableCompositorMacFactory() = default;
+
+RecyclableCompositorMacFactory::~RecyclableCompositorMacFactory() = default;
+
+std::unique_ptr<RecyclableCompositorMac>
+RecyclableCompositorMacFactory::CreateCompositor(
+    ui::ContextFactory* context_factory,
+    bool force_new) {
+  if (spare_compositors_.empty() || force_new) {
+    return std::make_unique<RecyclableCompositorMac>(context_factory);
+  }
+  std::unique_ptr<RecyclableCompositorMac> compositor =
+      std::move(spare_compositors_.front());
+  spare_compositors_.pop_front();
+  compositor->Unsuspend();
+  compositor->compositor()->SetBackgroundColor(SK_ColorTRANSPARENT);
+  return compositor;
+}
+
+void RecyclableCompositorMacFactory::RecycleCompositor(
+    std::unique_ptr<RecyclableCompositorMac> compositor) {
+  if (recycling_disabled_ || !compositor->recyclable_) {
+    return;
+  }
+  // Oa's own: ArcCore leaves a pooled compositor unlocked, and then it draws an
+  // empty frame that the next view to take it shows.
+  compositor->Suspend();
+  compositor->InvalidateSurface();
+  compositor->compositor()->SetBackgroundColor(SK_ColorTRANSPARENT);
+  compositor->widget()->SetSuspended(true);
+  spare_compositors_.push_front(std::move(compositor));
+  // Trimmed in a task, so that no compositor is freed in a nested loop that
+  // waits for a frame (https://crbug.com/828195).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&RecyclableCompositorMacFactory::ReduceSpareCompositors,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void RecyclableCompositorMacFactory::DisableRecyclingForShutdown() {
+  recycling_disabled_ = true;
+  spare_compositors_.clear();
+}
+
+void RecyclableCompositorMacFactory::ReduceSpareCompositors() {
+  while (spare_compositors_.size() > 1) {
+    spare_compositors_.pop_back();
+  }
+}
+
 }  // namespace ui
