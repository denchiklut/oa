@@ -69,6 +74,38 @@ class COMPOSITOR_EXPORT RecyclableCompositorMac
   std::unique_ptr<ui::AcceleratedWidgetMac> accelerated_widget_mac_;
   ui::Compositor compositor_;
   std::unique_ptr<ui::CompositorLock> compositor_suspended_lock_;
+  bool recyclable_ = true;
+};
+
+// Keeps the compositor of a view just hidden for the next view shown, as
+// ArcCore's restored factory does. Without it every shown page builds a new
+// compositor and shows nothing until its first frame.
+class COMPOSITOR_EXPORT RecyclableCompositorMacFactory {
+ public:
+  static RecyclableCompositorMacFactory* Get();
+
+  RecyclableCompositorMacFactory(const RecyclableCompositorMacFactory&) =
+      delete;
+  RecyclableCompositorMacFactory& operator=(
+      const RecyclableCompositorMacFactory&) = delete;
+
+  std::unique_ptr<RecyclableCompositorMac> CreateCompositor(
+      ui::ContextFactory* context_factory,
+      bool force_new);
+  void RecycleCompositor(std::unique_ptr<RecyclableCompositorMac> compositor);
+  void DisableRecyclingForShutdown();
+
+ private:
+  friend class base::NoDestructor<RecyclableCompositorMacFactory>;
+
+  RecyclableCompositorMacFactory();
+  ~RecyclableCompositorMacFactory();
+
+  void ReduceSpareCompositors();
+
+  bool recycling_disabled_ = false;
+  std::list<std::unique_ptr<RecyclableCompositorMac>> spare_compositors_;
+  base::WeakPtrFactory<RecyclableCompositorMacFactory> weak_factory_{this};
 };
 
 }  // namespace ui
