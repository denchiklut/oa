 void BrowserCompositorMac::TakeFallbackContentFrom(
     BrowserCompositorMac* other) {
+  force_new_compositor_once_ = true;
+  if (other->recyclable_compositor_) {
+    other->recyclable_compositor_->set_recyclable(false);
+  }
   delegated_frame_host_->TakeFallbackContentFrom(
       other->delegated_frame_host_.get());
 }
