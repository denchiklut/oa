From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denchiklut <ollylut@gmail.com>
Date: Wed, 25 Nov 2026 19:08:16 -0700
Subject: [PATCH] oa: size extension action icons at 32 pt as ArcCore does

---
 extensions/browser/extension_action.cc | 3 +++
 extensions/browser/icon_util.cc        | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/extensions/browser/extension_action.cc b/extensions/browser/extension_action.cc
index 47efaf855f3bbc3e70b2297ff96fd58197ab2d7b..77c76b6fe981957d94d5235507e1c6e74febd142 100644
--- a/extensions/browser/extension_action.cc
+++ b/extensions/browser/extension_action.cc
@@ -74,6 +74,9 @@ bool HasValue(const std::map<int, T>& map, ExtensionAction::TabID tab_id) {
 extension_misc::ExtensionIcons ExtensionAction::ActionIconSize() {
 #if BUILDFLAG(IS_ANDROID)
   return extension_misc::EXTENSION_ICON_MINI;
+#elif BUILDFLAG(IS_MAC)
+  // As ArcCore: 32 pt so the icon fills its canvas and scales to 16 pt in UI.
+  return extension_misc::EXTENSION_ICON_SMALL;
 #else
   return extension_misc::EXTENSION_ICON_BITTY;
 #endif
diff --git a/extensions/browser/icon_util.cc b/extensions/browser/icon_util.cc
index edd8964a220ebf9d99789fcf252b3455e55ad2e9..d4fcbf9609108166b955205add9bdb24cdfe093d 100644
--- a/extensions/browser/icon_util.cc
+++ b/extensions/browser/icon_util.cc
@@ -22,6 +22,8 @@ namespace extensions {
 // LINT.IfChange(ActionIconSize)
 #if BUILDFLAG(IS_ANDROID)
 constexpr int kActionIconSize = extension_misc::EXTENSION_ICON_MINI;
+#elif BUILDFLAG(IS_MAC)
+constexpr int kActionIconSize = extension_misc::EXTENSION_ICON_SMALL;
 #else
 constexpr int kActionIconSize = extension_misc::EXTENSION_ICON_BITTY;
 #endif
