diff --git a/front_end/devtools_compatibility.js b/front_end/devtools_compatibility.js
index cd487260aeb4db92f47404190e5e608156b1a914..9dfdb534512fe9c4e9f255d44bca11a18d0fcedd 100644
--- a/front_end/devtools_compatibility.js
+++ b/front_end/devtools_compatibility.js
@@ -378,6 +378,26 @@
       this._dispatchOnInspectorFrontendAPI('showPanel', [panelName]);
     }
 
+  /**
+   * @return {string} name of the current panel
+   */
+  currentPanel() {
+    /**
+     * Lets define the class inside the function itself to scope limit it and
+     * keep the patch with minimal hunks. In JavaScript, all the classes and
+     * functions are passed-by-reference. We are passing the CurrentPanelEvent
+     * as an object that will be updated by the event handler inside inspector
+     */
+    class CurrentPanelEvent {
+      constructor() {
+        this.panelName = '';
+      }
+    }
+    const event = new CurrentPanelEvent();
+    this._dispatchOnInspectorFrontendAPI('currentPanel', [event]);
+    return event.panelName;
+  }
+
     /**
      * @param {number} id
      * @param {string} chunk
@@ -1405,6 +1425,12 @@
     setIsDocked(isDocked, callback) {
       DevToolsAPI.sendMessageToEmbedder('setIsDocked', [isDocked], callback);
     }
+    requestDockPosition(dockPosition) {
+      DevToolsAPI.sendMessageToEmbedder('requestDockPosition', [dockPosition]);
+    }
+    inspectModeChanged(inspectMode) {
+      DevToolsAPI.sendMessageToEmbedder('inspectModeChanged', [inspectMode], null);
+    }
 
     /**
      * @param trigger
