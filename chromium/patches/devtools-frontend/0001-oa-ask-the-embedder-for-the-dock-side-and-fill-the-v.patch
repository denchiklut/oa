   /* eslint-enable @typescript-eslint/naming-convention */
 }
 
@@ -76,6 +77,7 @@ export const EventDescriptors: ReadonlyArray<readonly[Events, readonly string[],
   [Events.SetInspectedTabId, ['tabId']],
   [Events.SetUseSoftMenu, ['useSoftMenu']],
   [Events.ShowPanel, ['panelName']],
+  [Events.CurrentPanel, ['currentPanelEvent']],
 ] as const;
 
 export interface DispatchMessageChunkEvent {
@@ -269,6 +271,7 @@ export interface EventTypes {
   [Events.SetInspectedTabId]: string;
   [Events.SetUseSoftMenu]: boolean;
   [Events.ShowPanel]: string;
+  [Events.CurrentPanel]: {panelName: string};
 }
 
 export type DispatchHttpRequestRequest = {
@@ -424,6 +427,10 @@ export interface InspectorFrontendHostAPI {
 
   setIsDocked(isDocked: boolean, callback: () => void): void;
 
+  requestDockPosition(dockPosition: string): void;
+
+  inspectModeChanged(inspectMode: string): void;
+
   showSurvey(trigger: string, callback: (arg0: ShowSurveyResult) => void): void;
 
