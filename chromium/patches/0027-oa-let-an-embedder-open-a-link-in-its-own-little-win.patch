From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denchiklut <ollylut@gmail.com>
Date: Tue, 24 Nov 2026 23:23:35 -0700
Subject: [PATCH] oa: let an embedder open a link in its own little window, as
 ArcCore does

---
 chrome/app/chrome_command_ids.h               |  3 +++
 .../render_view_context_menu.cc               | 23 +++++++++++++++++++
 .../navigation_capturing_process.cc           |  2 ++
 components/blocked_content/popup_blocker.cc   |  1 +
 ui/base/mojom/window_open_disposition.mojom   |  2 ++
 .../window_open_disposition_mojom_traits.h    |  4 ++++
 ui/base/window_open_disposition.h             |  5 +++-
 7 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/chrome/app/chrome_command_ids.h b/chrome/app/chrome_command_ids.h
index e7b9327ce3fd4664d5e152b44cff1cf859b57fe7..fed18106a2a990e32d834753556318a26e2ea849 100644
--- a/chrome/app/chrome_command_ids.h
+++ b/chrome/app/chrome_command_ids.h
@@ -517,6 +517,9 @@
 #define IDC_CONTENT_CONTEXT_AUTOFILL_FALLBACK_PASSWORDS_USE_PASSKEY_FROM_ANOTHER_DEVICE 53002
 #define IDC_CONTENT_CONTEXT_AUTOFILL_FALLBACK_AT_MEMORY 53003
 
+// Oa: an embedder's "open link in its little window", ArcCore's ID.
+#define IDC_CONTENT_CONTEXT_OPENLINKLITTLEWINDOW 53249
+
 // Live Caption
 #define IDC_LIVE_CAPTION 53251
 
diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.cc b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
index 5799fc7294e66a658be39f34de67dde1ad4ce574..25288afef34f2d698e6b32005ae330e932ad1bf2 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.cc
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
@@ -777,6 +777,12 @@ int CollapseCommandsForUMA(int id) {
     return IDC_OPEN_LINK_IN_PROFILE_FIRST;
   }
 
+  // Oa: an embedder's item has no value in the enums; it counts as the
+  // nearest of Chrome's.
+  if (id == IDC_CONTENT_CONTEXT_OPENLINKLITTLEWINDOW) {
+    return IDC_CONTENT_CONTEXT_OPENLINKNEWWINDOW;
+  }
+
   return id;
 }
 
@@ -3582,6 +3588,11 @@ bool RenderViewContextMenu::IsCommandIdEnabled(int id) const {
              params_.link_url.IsStandard() &&
              IsOpenLinkAllowedByDlp(params_.link_url);
 
+    // Oa: the item an embedder's model editor adds, as ArcCore's.
+    case IDC_CONTENT_CONTEXT_OPENLINKLITTLEWINDOW:
+      return params_.link_url.is_valid() && params_.link_url.IsStandard() &&
+             !GetProfile()->IsOffTheRecord();
+
     case IDC_CONTENT_CONTEXT_COPYLINKLOCATION:
       return params_.unfiltered_link_url.is_valid();
 
@@ -3963,6 +3974,18 @@ void RenderViewContextMenu::ExecuteCommand(int id, int event_flags) {
               chrome_navigation_initiator::kContextMenuOpenLink));
       break;
 
+    // Oa: the link goes to the page's delegate as an open with the little
+    // window disposition, as ArcCore's.
+    case IDC_CONTENT_CONTEXT_OPENLINKLITTLEWINDOW:
+      OpenURLWithExtraHeaders(
+          params_.link_url, params_.frame_url, params_.frame_origin,
+          WindowOpenDisposition::LITTLE_WINDOW, ui::PAGE_TRANSITION_LINK,
+          /*extra_headers=*/std::string(),
+          /*started_from_context_menu=*/true,
+          page_load_metrics::NavigationInitiatorHolder::AttacherCallback(
+              chrome_navigation_initiator::kContextMenuOpenLink));
+      break;
+
     case IDC_CONTENT_CONTEXT_OPENLINKBOOKMARKAPP:
       ExecOpenWebApp();
       break;
diff --git a/chrome/browser/ui/web_applications/navigation_capturing_process.cc b/chrome/browser/ui/web_applications/navigation_capturing_process.cc
index 6083942bb1651764c083d17d5ffdf272d1d43ec2..52466d2ed740133f31046c92d9934bbfd792f399 100644
--- a/chrome/browser/ui/web_applications/navigation_capturing_process.cc
+++ b/chrome/browser/ui/web_applications/navigation_capturing_process.cc
@@ -86,6 +86,7 @@ bool IsDispositionValidForNavigationCapturing(
     case WindowOpenDisposition::NEW_PICTURE_IN_PICTURE:
     case WindowOpenDisposition::NEW_SPLIT_VIEW:
     case WindowOpenDisposition::SPLIT_VIEW:
+    case WindowOpenDisposition::LITTLE_WINDOW:
       return false;
   }
 }
@@ -956,6 +957,7 @@ NavigationCapturingProcess::HandleIsolatedWebAppNavigation(
       case WindowOpenDisposition::SWITCH_TO_TAB:
       case WindowOpenDisposition::NEW_SPLIT_VIEW:
       case WindowOpenDisposition::SPLIT_VIEW:
+      case WindowOpenDisposition::LITTLE_WINDOW:
         // These are not supposed to be reachable with IWA URLs.
         return true;
     }
diff --git a/components/blocked_content/popup_blocker.cc b/components/blocked_content/popup_blocker.cc
index 97bf6041e2fcd3f723b2ff4f1e2faf59d7c55235..33cb60d0ee9a540e615d3fedc4357fc1bb3a76dc 100644
--- a/components/blocked_content/popup_blocker.cc
+++ b/components/blocked_content/popup_blocker.cc
@@ -105,6 +105,7 @@ bool ConsiderForPopupBlocking(WindowOpenDisposition disposition) {
     case WindowOpenDisposition::IGNORE_ACTION:
     case WindowOpenDisposition::SWITCH_TO_TAB:
     case WindowOpenDisposition::SPLIT_VIEW:
+    case WindowOpenDisposition::LITTLE_WINDOW:
       return false;
     case WindowOpenDisposition::NEW_POPUP:
     case WindowOpenDisposition::NEW_FOREGROUND_TAB:
diff --git a/ui/base/mojom/window_open_disposition.mojom b/ui/base/mojom/window_open_disposition.mojom
index dbd264ce2c8fca16fa1bfde22dc3acec51c9c1cc..b4bf64f435a21f968e4e396e86e7a5bd282e2b37 100644
--- a/ui/base/mojom/window_open_disposition.mojom
+++ b/ui/base/mojom/window_open_disposition.mojom
@@ -34,6 +34,8 @@ enum WindowOpenDisposition {
   NEW_SPLIT_VIEW,
   // Oa: an embedder's own split view, as ArcCore's value.
   SPLIT_VIEW,
+  // Oa: an embedder's little window, as ArcCore's value.
+  LITTLE_WINDOW,
 };
 
 // Click information needed to determine user's desired window disposition using
diff --git a/ui/base/mojom/window_open_disposition_mojom_traits.h b/ui/base/mojom/window_open_disposition_mojom_traits.h
index c9123ab8904262f80f98b9d5bcc8e434a897dd2d..2706b32d5982e7f17d02117fd04473cfcadd2b1d 100644
--- a/ui/base/mojom/window_open_disposition_mojom_traits.h
+++ b/ui/base/mojom/window_open_disposition_mojom_traits.h
@@ -45,6 +45,8 @@ struct EnumTraits<ui::mojom::WindowOpenDisposition, WindowOpenDisposition> {
         return ui::mojom::WindowOpenDisposition::NEW_SPLIT_VIEW;
       case WindowOpenDisposition::SPLIT_VIEW:
         return ui::mojom::WindowOpenDisposition::SPLIT_VIEW;
+      case WindowOpenDisposition::LITTLE_WINDOW:
+        return ui::mojom::WindowOpenDisposition::LITTLE_WINDOW;
     }
     NOTREACHED();
   }
@@ -80,6 +82,8 @@ struct EnumTraits<ui::mojom::WindowOpenDisposition, WindowOpenDisposition> {
         return WindowOpenDisposition::NEW_SPLIT_VIEW;
       case ui::mojom::WindowOpenDisposition::SPLIT_VIEW:
         return WindowOpenDisposition::SPLIT_VIEW;
+      case ui::mojom::WindowOpenDisposition::LITTLE_WINDOW:
+        return WindowOpenDisposition::LITTLE_WINDOW;
     }
     NOTREACHED();
   }
diff --git a/ui/base/window_open_disposition.h b/ui/base/window_open_disposition.h
index 304a3f4d179541898d90e8c276266b8865492519..a45db3e58bf26a6028f700d42193faf7c695492b 100644
--- a/ui/base/window_open_disposition.h
+++ b/ui/base/window_open_disposition.h
@@ -31,8 +31,11 @@ enum class WindowOpenDisposition {
   // Oa: an embedder's own split view, as ArcCore's value. Only its page
   // context menu sends it, so Blink's NEW_SPLIT_VIEW stays a click's.
   SPLIT_VIEW,
+  // Oa: an embedder's little window, as ArcCore's value, sent by its page
+  // context menu.
+  LITTLE_WINDOW,
   // Update when adding a new disposition.
-  MAX_VALUE = SPLIT_VIEW,
+  MAX_VALUE = LITTLE_WINDOW,
 };
 
 #endif  // UI_BASE_WINDOW_OPEN_DISPOSITION_H_
