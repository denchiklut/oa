 .../devtools_embedder_message_dispatcher.h    |   2 +
 .../browser/devtools/devtools_ui_bindings.cc  |   8 ++
 .../browser/devtools/devtools_ui_bindings.h   |   6 +
 chrome/browser/devtools/devtools_window.cc    | 129 +++++++++++++++++-
 chrome/browser/devtools/devtools_window.h     |  43 ++++++
 6 files changed, 191 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/devtools/devtools_embedder_message_dispatcher.cc b/chrome/browser/devtools/devtools_embedder_message_dispatcher.cc
