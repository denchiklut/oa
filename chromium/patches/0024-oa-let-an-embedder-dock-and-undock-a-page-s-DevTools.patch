     virtual void SetWhitelistedShortcuts(const std::string& message) = 0;
@@ -218,6 +222,8 @@ class DevToolsUIBindings : public DevToolsEmbedderMessageDispatcher::Delegate,
                            const std::string& headers,
                            int stream_id) override;
   void SetIsDocked(DispatchCallback callback, bool is_docked) override;
+  void RequestDockPosition(const std::string& dock_side) override;
+  void InspectModeChanged(const std::string& inspect_mode) override;
   void OpenInNewTab(const std::string& url) override;
   void OpenSearchResultsInNewTab(const std::string& query) override;
   void ShowItemInFolder(const std::string& file_system_path) override;
diff --git a/chrome/browser/devtools/devtools_window.cc b/chrome/browser/devtools/devtools_window.cc
index e9803277eecb82c0769b02e3e48207d110b781af..1998350c3ef994cbb1509a05e8f46a679dedab5d 100644
--- a/chrome/browser/devtools/devtools_window.cc
+++ b/chrome/browser/devtools/devtools_window.cc
@@ -139,6 +139,16 @@ using content::WebContents;
 
 namespace {
 
+// Where a page's embedder is kept, as ArcCore keeps its per-page DevTools
+// Impl on the inspected WebContents.
+const char kEmbedderUserDataKey[] = "DevToolsWindow::Embedder";
+
+struct EmbedderUserData : public base::SupportsUserData::Data {
+  explicit EmbedderUserData(DevToolsWindow::Embedder* embedder)
+      : embedder(embedder) {}
+  raw_ptr<DevToolsWindow::Embedder> embedder;
+};
+
 typedef std::vector<DevToolsWindow*> DevToolsWindows;
 DevToolsWindows& GetDevToolsWindowInstances() {
   static base::NoDestructor<DevToolsWindows> instances;
@@ -874,6 +884,10 @@ void DevToolsWindow::ToggleDevToolsWindow(
     const std::string& settings,
     DevToolsOpenedByAction toggled_by,
     const content::DevToolsManagerDelegate::DevToolsOptions& devtools_options) {
+  if (Embedder* embedder = Embedder::FromWebContents(inspected_web_contents)) {
+    embedder->Toggle(force_open, action);
+    return;
+  }
   scoped_refptr<DevToolsAgentHost> agent(
       DevToolsAgentHost::GetOrCreateForTab(inspected_web_contents));
   DevToolsWindow* window = FindDevToolsWindow(agent.get());
@@ -949,6 +963,83 @@ void DevToolsWindow::ToggleDevToolsWindow(
   }
 }
 
+// static
+DevToolsWindow::Embedder* DevToolsWindow::Embedder::FromWebContents(
+    WebContents* inspected_web_contents) {
+  if (!inspected_web_contents) {
+    return nullptr;
+  }
+  auto* data = static_cast<EmbedderUserData*>(
+      inspected_web_contents->GetUserData(kEmbedderUserDataKey));
+  return data ? data->embedder.get() : nullptr;
+}
+
+// static
+void DevToolsWindow::Embedder::SetForWebContents(
+    WebContents* inspected_web_contents,
+    Embedder* embedder) {
+  if (!embedder) {
+    inspected_web_contents->RemoveUserData(kEmbedderUserDataKey);
+    return;
+  }
+  inspected_web_contents->SetUserData(
+      kEmbedderUserDataKey, std::make_unique<EmbedderUserData>(embedder));
+}
+
+// static
+void DevToolsWindow::CallDevToolsAPIForEmbedder(
+    WebContents* inspected_web_contents,
+    const std::string& method,
+    base::OnceCallback<void(base::Value)> callback) {
+  DevToolsWindow* window =
+      GetInstanceForInspectedWebContents(inspected_web_contents);
+  if (!window || window->life_stage_ != kLoadCompleted) {
+    std::move(callback).Run(base::Value());
+    return;
+  }
+  window->bindings_->CallClientMethod("DevToolsAPI", method, {}, {}, {},
+                                      std::move(callback));
+}
+
+// static
+void DevToolsWindow::OpenForEmbedder(WebContents* inspected_web_contents,
+                                     const std::string& panel,
+                                     const DevToolsToggleAction& action) {
+  scoped_refptr<DevToolsAgentHost> agent(
+      DevToolsAgentHost::GetOrCreateForTab(inspected_web_contents));
+  if (DevToolsWindow* window = FindDevToolsWindow(agent.get())) {
+    if (window->life_stage_ != kLoadCompleted) {
+      window->ScheduleShow(action);
+      return;
+    }
+    if (!panel.empty()) {
+      window->bindings_->CallClientMethod("DevToolsAPI", "showPanel",
+                                          base::Value(panel));
+    }
+    window->DoAction(action);
+    return;
+  }
+  DevToolsWindow* window =
+      Create(GetProfileForDevToolsWindow(inspected_web_contents),
+             inspected_web_contents, kFrontendDefault, std::string(),
+             /*can_dock=*/true, std::string(), panel, agent->IsAttached(),
+             /*browser_connection=*/false,
+             DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+  if (!window) {
+    return;
+  }
+  window->bindings_->AttachTo(agent.get());
+  window->ScheduleShow(action);
+}
+
+// static
+void DevToolsWindow::CloseForEmbedder(WebContents* inspected_web_contents) {
+  if (DevToolsWindow* window =
+          GetInstanceForInspectedWebContents(inspected_web_contents)) {
+    window->Close(DevToolsClosedByAction::kMainMenuOrMainShortcut);
+  }
+}
+
 // static
 void DevToolsWindow::InspectElement(
     content::RenderFrameHost* inspected_frame_host,
@@ -956,6 +1047,10 @@ void DevToolsWindow::InspectElement(
     int y) {
   WebContents* web_contents =
       WebContents::FromRenderFrameHost(inspected_frame_host);
+  if (Embedder* embedder = Embedder::FromWebContents(web_contents)) {
+    embedder->InspectElement(inspected_frame_host, x, y);
+    return;
+  }
   scoped_refptr<DevToolsAgentHost> agent(
       DevToolsAgentHost::GetOrCreateForTab(web_contents));
   agent->InspectElement(inspected_frame_host, x, y);
@@ -1415,7 +1510,9 @@ DevToolsWindow* DevToolsWindow::Create(
 #endif  // BUILDFLAG(IS_MAC)
     DevtoolsUIController* devtools_ui_controller =
         browser ? DevtoolsUIController::From(browser) : nullptr;
-    if (!devtools_ui_controller || !devtools_ui_controller->CanDockDevtools()) {
+    if (!Embedder::FromWebContents(inspected_web_contents) &&
+        (!devtools_ui_controller ||
+                        !devtools_ui_controller->CanDockDevtools())) {
       can_dock = false;
     }
   }
@@ -1573,6 +1670,12 @@ WebContents* DevToolsWindow::OpenURLFromInspectedTab(
 }
 
 void DevToolsWindow::ActivateContents(WebContents* contents) {
+  // As ArcCore's: the embedder gives its DevTools the keyboard.
+  if (Embedder* embedder =
+          Embedder::FromWebContents(GetInspectedWebContents())) {
+    embedder->NeedsFocus();
+    return;
+  }
   if (is_docked_) {
     WebContents* inspected_tab = GetInspectedWebContents();
     if (inspected_tab) {
@@ -1722,6 +1825,11 @@ void DevToolsWindow::ActivateWindow() {
   if (life_stage_ != kLoadCompleted) {
     return;
   }
+  if (Embedder* embedder =
+          Embedder::FromWebContents(GetInspectedWebContents())) {
+    embedder->NeedsFocus();
+    return;
+  }
 #if BUILDFLAG(IS_ANDROID)
   NOTIMPLEMENTED();
 #else
@@ -1796,6 +1904,11 @@ void DevToolsWindow::SetIsDocked(bool dock_requested) {
   if (!can_dock_) {
     dock_requested = false;
   }
+  // An embedder moves the frontend itself, on the dock side it asks for, so
+  // it stays docked here, as ArcCore's does.
+  if (can_dock_ && Embedder::FromWebContents(GetInspectedWebContents())) {
+    dock_requested = true;
+  }
 
   bool was_docked = is_docked_;
   is_docked_ = dock_requested;
@@ -1843,6 +1956,20 @@ void DevToolsWindow::SetIsDocked(bool dock_requested) {
   Show(DevToolsToggleAction::Show());
 }
 
+void DevToolsWindow::RequestDockPosition(const std::string& dock_side) {
+  if (Embedder* embedder =
+          Embedder::FromWebContents(GetInspectedWebContents())) {
+    embedder->DockSideRequested(dock_side);
+  }
+}
+
+void DevToolsWindow::InspectModeChanged(const std::string& inspect_mode) {
+  if (Embedder* embedder =
+          Embedder::FromWebContents(GetInspectedWebContents())) {
+    embedder->InspectModeChanged(inspect_mode);
+  }
+}
+
 int DevToolsWindow::GetDockStateForLogging() {
   const int kUndocked = 0;
   const int kLeft = 1;
diff --git a/chrome/browser/devtools/devtools_window.h b/chrome/browser/devtools/devtools_window.h
index b2fd119f429b4bd6ef2b72084173224110cf9891..f010d20932e3f704e31a86c0d05ce27ce6a215df 100644
--- a/chrome/browser/devtools/devtools_window.h
+++ b/chrome/browser/devtools/devtools_window.h
@@ -330,6 +330,47 @@ class DevToolsWindow : public DevToolsUIBindings::Delegate,
   // Attaches this devtools window to the given browser.
   void AttachToBrowser(BrowserWindowInterface* browser);
 
+  // A page's DevTools that an embedder lays out itself, beside the page or in
+  // a window of its own, as ArcCore's per-page Impl. Found on the inspected
+  // page: Chrome's toggles, the page menu's Inspect and the frontend's dock
+  // side and focus requests for that page go to it, and its frontend can dock
+  // without a DevtoolsUIController, so no DevTools browser is made.
+  class Embedder {
+   public:
+    static Embedder* FromWebContents(
+        content::WebContents* inspected_web_contents);
+    // `embedder` outlives its page's entry; nullptr removes it.
+    static void SetForWebContents(content::WebContents* inspected_web_contents,
+                                  Embedder* embedder);
+
+    virtual void Toggle(bool force_open,
+                        const DevToolsToggleAction& action) = 0;
+    virtual void InspectElement(content::RenderFrameHost* inspected_frame_host,
+                                int x,
+                                int y) = 0;
+    // "undocked", "left", "right" or "bottom", as the frontend asks.
+    virtual void DockSideRequested(const std::string& dock_side) = 0;
+    // An Overlay.InspectMode of the protocol; "none" when no element is being
+    // picked.
+    virtual void InspectModeChanged(const std::string& inspect_mode) = 0;
+    virtual void NeedsFocus() = 0;
+
+   protected:
+    virtual ~Embedder() = default;
+  };
+  // For the embedder: shows `panel` in the page's open DevTools, or opens them
+  // on it, then performs `action`; never asks the embedder.
+  static void OpenForEmbedder(content::WebContents* inspected_web_contents,
+                              const std::string& panel,
+                              const DevToolsToggleAction& action);
+  static void CloseForEmbedder(content::WebContents* inspected_web_contents);
+  // Calls the frontend's DevToolsAPI `method` and hands back its result, a
+  // null value while no frontend is loaded.
+  static void CallDevToolsAPIForEmbedder(
+      content::WebContents* inspected_web_contents,
+      const std::string& method,
+      base::OnceCallback<void(base::Value)> callback);
+
  private:
   friend class DevToolsWindowTesting;
   friend class DevToolsWindowCreationObserver;
@@ -477,6 +518,8 @@ class DevToolsWindow : public DevToolsUIBindings::Delegate,
   void SetInspectedPageBounds(const gfx::Rect& rect) override;
   void InspectElementCompleted() override;
   void SetIsDocked(bool is_docked) override;
+  void RequestDockPosition(const std::string& dock_side) override;
+  void InspectModeChanged(const std::string& inspect_mode) override;
   void OpenInNewTab(const std::string& url) override;
   void OpenSearchResultsInNewTab(const std::string& url) override;
   void SetWhitelistedShortcuts(const std::string& message) override;
