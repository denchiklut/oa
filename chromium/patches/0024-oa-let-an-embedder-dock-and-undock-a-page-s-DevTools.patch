@@ -386,6 +386,10 @@ DevToolsEmbedderMessageDispatcher::CreateForDevToolsFrontend(
                      AllowedFrontend::kAny);
   d->RegisterHandlerWithCallback("setIsDocked", &Delegate::SetIsDocked,
                                  AllowedFrontend::kAny);
+  d->RegisterHandler("requestDockPosition", &Delegate::RequestDockPosition,
+                     AllowedFrontend::kAny);
+  d->RegisterHandler("inspectModeChanged", &Delegate::InspectModeChanged,
+                     AllowedFrontend::kAny);
   d->RegisterHandler("openInNewTab", &Delegate::OpenInNewTab,
                      AllowedFrontend::kAny);
   d->RegisterHandler("openSearchResultsInNewTab",
diff --git a/chrome/browser/devtools/devtools_embedder_message_dispatcher.h b/chrome/browser/devtools/devtools_embedder_message_dispatcher.h
