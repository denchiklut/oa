 .../render_widget_host_delegate.cc            |  6 ++++
 .../render_widget_host_delegate.h             |  5 +++
 .../render_widget_host_view_mac.h             |  3 ++
 .../render_widget_host_view_mac.mm            | 10 ++++++
 .../browser/web_contents/web_contents_impl.cc | 16 +++++++++
