@@ -17,6 +17,7 @@
 #import "base/apple/foundation_util.h"
 #include "base/apple/owned_objc.h"
 #include "base/debug/crash_logging.h"
+#include "base/functional/bind.h"
 #import "base/mac/mac_util.h"
 #include "base/memory/raw_ptr.h"
 #include "base/numerics/safe_conversions.h"
@@ -2943,12 +2944,42 @@ WebMouseEvent event(WebInputEvent::Type::kMouseUp,
   }
 }
 
+// As ArcCore: the page undoes first, and when it had nothing to undo, the
+// first undo manager up the responder chain that has, which is the window's.
 - (void)undo:(id)sender {
-  _host->Undo();
+  __weak RenderWidgetHostViewCocoa* weakSelf = self;
+  _host->ExecuteEditCommandWithResult(
+      "Undo", base::BindOnce(^(bool handled) {
+        if (handled) {
+          return;
+        }
+        for (NSResponder* responder = weakSelf.nextResponder; responder;
+             responder = responder.nextResponder) {
+          NSUndoManager* undoManager = responder.undoManager;
+          if (undoManager.canUndo) {
+            [undoManager undo];
+            return;
+          }
+        }
+      }));
 }
 
 - (void)redo:(id)sender {
-  _host->Redo();
+  __weak RenderWidgetHostViewCocoa* weakSelf = self;
+  _host->ExecuteEditCommandWithResult(
+      "Redo", base::BindOnce(^(bool handled) {
+        if (handled) {
+          return;
+        }
+        for (NSResponder* responder = weakSelf.nextResponder; responder;
+             responder = responder.nextResponder) {
+          NSUndoManager* undoManager = responder.undoManager;
+          if (undoManager.canRedo) {
+            [undoManager redo];
+            return;
+          }
+        }
+      }));
 }
 
 - (void)cut:(id)sender {
