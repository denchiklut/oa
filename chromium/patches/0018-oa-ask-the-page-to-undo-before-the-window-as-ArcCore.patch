+void WebContentsImpl::ExecuteEditCommandWithResult(
+    const std::string& command,
+    base::OnceCallback<void(bool)> callback) {
+  auto* input_handler = GetFocusedFrameWidgetInputHandler();
+  if (!input_handler) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  last_interaction_time_ = ui::EventTimeForNow();
+  input_handler->ExecuteEditCommandWithResult(
+      command, mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+                                                           false));
+}
