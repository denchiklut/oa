 }
 
+void FrameWidgetInputHandlerImpl::ExecuteEditCommandWithResult(
+    const String& command,
+    ExecuteEditCommandWithResultCallback callback) {
+  // As SelectAroundCaret: the reply runs on the thread the channel is bound to.
+  if (ThreadedCompositingEnabled()) {
+    callback = base::BindOnce(
+        [](scoped_refptr<base::SingleThreadTaskRunner> callback_task_runner,
+           ExecuteEditCommandWithResultCallback callback, bool handled) {
+          callback_task_runner->PostTask(
+              FROM_HERE, base::BindOnce(std::move(callback), handled));
+        },
+        base::SingleThreadTaskRunner::GetCurrentDefault(), std::move(callback));
+  }
+
+  RunOnMainThread(base::BindOnce(
+      [](base::WeakPtr<WidgetBase> widget,
+         base::WeakPtr<mojom::blink::FrameWidgetInputHandler> handler,
+         const String& command,
+         ExecuteEditCommandWithResultCallback callback) {
+        if (!widget || !handler) {
+          std::move(callback).Run(false);
+          return;
+        }
+        HandlingState handling_state(widget, UpdateState::kNone);
+        handler->ExecuteEditCommandWithResult(command, std::move(callback));
+      },
+      widget_, main_thread_frame_widget_input_handler_, command,
+      std::move(callback)));
+}
