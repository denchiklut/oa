From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: denchiklut <ollylut@gmail.com>
Date: Tue, 24 Nov 2026 23:23:26 -0700
Subject: [PATCH] oa: open an embedder's split view by a disposition of its
 own, as ArcCore does

---
 .../renderer_context_menu/render_view_context_menu.cc        | 2 +-
 .../ui/web_applications/navigation_capturing_process.cc      | 2 ++
 components/blocked_content/popup_blocker.cc                  | 1 +
 ui/base/mojom/window_open_disposition.mojom                  | 2 ++
 ui/base/mojom/window_open_disposition_mojom_traits.h         | 4 ++++
 ui/base/window_open_disposition.h                            | 5 ++++-
 6 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/renderer_context_menu/render_view_context_menu.cc b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
index 0e2efbfe976b7dbec70cd481cf83ea14c752821d..5799fc7294e66a658be39f34de67dde1ad4ce574 100644
--- a/chrome/browser/renderer_context_menu/render_view_context_menu.cc
+++ b/chrome/browser/renderer_context_menu/render_view_context_menu.cc
@@ -3975,7 +3975,7 @@ void RenderViewContextMenu::ExecuteCommand(int id, int event_flags) {
       if (g_embedder_model_editor) {
         OpenURLWithExtraHeaders(
             params_.link_url, params_.frame_url, params_.frame_origin,
-            WindowOpenDisposition::NEW_SPLIT_VIEW, ui::PAGE_TRANSITION_LINK,
+            WindowOpenDisposition::SPLIT_VIEW, ui::PAGE_TRANSITION_LINK,
             /*extra_headers=*/std::string(),
             /*started_from_context_menu=*/true,
             page_load_metrics::NavigationInitiatorHolder::AttacherCallback(
diff --git a/chrome/browser/ui/web_applications/navigation_capturing_process.cc b/chrome/browser/ui/web_applications/navigation_capturing_process.cc
index b87b57f42c111091550e341d01db163c90722da9..6083942bb1651764c083d17d5ffdf272d1d43ec2 100644
--- a/chrome/browser/ui/web_applications/navigation_capturing_process.cc
+++ b/chrome/browser/ui/web_applications/navigation_capturing_process.cc
@@ -85,6 +85,7 @@ bool IsDispositionValidForNavigationCapturing(
     case WindowOpenDisposition::SWITCH_TO_TAB:
     case WindowOpenDisposition::NEW_PICTURE_IN_PICTURE:
     case WindowOpenDisposition::NEW_SPLIT_VIEW:
+    case WindowOpenDisposition::SPLIT_VIEW:
       return false;
   }
 }
@@ -954,6 +955,7 @@ NavigationCapturingProcess::HandleIsolatedWebAppNavigation(
       case WindowOpenDisposition::IGNORE_ACTION:
       case WindowOpenDisposition::SWITCH_TO_TAB:
       case WindowOpenDisposition::NEW_SPLIT_VIEW:
+      case WindowOpenDisposition::SPLIT_VIEW:
         // These are not supposed to be reachable with IWA URLs.
         return true;
     }
diff --git a/components/blocked_content/popup_blocker.cc b/components/blocked_content/popup_blocker.cc
index ca58e000ae7bc363637b38a9d478bac559e67916..97bf6041e2fcd3f723b2ff4f1e2faf59d7c55235 100644
--- a/components/blocked_content/popup_blocker.cc
+++ b/components/blocked_content/popup_blocker.cc
@@ -104,6 +104,7 @@ bool ConsiderForPopupBlocking(WindowOpenDisposition disposition) {
     case WindowOpenDisposition::SAVE_TO_DISK:
     case WindowOpenDisposition::IGNORE_ACTION:
     case WindowOpenDisposition::SWITCH_TO_TAB:
+    case WindowOpenDisposition::SPLIT_VIEW:
       return false;
     case WindowOpenDisposition::NEW_POPUP:
     case WindowOpenDisposition::NEW_FOREGROUND_TAB:
diff --git a/ui/base/mojom/window_open_disposition.mojom b/ui/base/mojom/window_open_disposition.mojom
index d4a891ed27969c354c34bdacb69778eae3dbf8c4..dbd264ce2c8fca16fa1bfde22dc3acec51c9c1cc 100644
--- a/ui/base/mojom/window_open_disposition.mojom
+++ b/ui/base/mojom/window_open_disposition.mojom
@@ -32,6 +32,8 @@ enum WindowOpenDisposition {
   NEW_PICTURE_IN_PICTURE,
   // Opens a link in a split view alongside the current tab.
   NEW_SPLIT_VIEW,
+  // Oa: an embedder's own split view, as ArcCore's value.
+  SPLIT_VIEW,
 };
 
 // Click information needed to determine user's desired window disposition using
diff --git a/ui/base/mojom/window_open_disposition_mojom_traits.h b/ui/base/mojom/window_open_disposition_mojom_traits.h
index 5a248db1eb26d3abe95ad97da5a1bd354b8d1591..c9123ab8904262f80f98b9d5bcc8e434a897dd2d 100644
--- a/ui/base/mojom/window_open_disposition_mojom_traits.h
+++ b/ui/base/mojom/window_open_disposition_mojom_traits.h
@@ -43,6 +43,8 @@ struct EnumTraits<ui::mojom::WindowOpenDisposition, WindowOpenDisposition> {
         return ui::mojom::WindowOpenDisposition::SWITCH_TO_TAB;
       case WindowOpenDisposition::NEW_SPLIT_VIEW:
         return ui::mojom::WindowOpenDisposition::NEW_SPLIT_VIEW;
+      case WindowOpenDisposition::SPLIT_VIEW:
+        return ui::mojom::WindowOpenDisposition::SPLIT_VIEW;
     }
     NOTREACHED();
   }
@@ -76,6 +78,8 @@ struct EnumTraits<ui::mojom::WindowOpenDisposition, WindowOpenDisposition> {
         return WindowOpenDisposition::SWITCH_TO_TAB;
       case ui::mojom::WindowOpenDisposition::NEW_SPLIT_VIEW:
         return WindowOpenDisposition::NEW_SPLIT_VIEW;
+      case ui::mojom::WindowOpenDisposition::SPLIT_VIEW:
+        return WindowOpenDisposition::SPLIT_VIEW;
     }
     NOTREACHED();
   }
diff --git a/ui/base/window_open_disposition.h b/ui/base/window_open_disposition.h
index 7682088e0bf2fd12f829eea2ea748669fe742fcd..304a3f4d179541898d90e8c276266b8865492519 100644
--- a/ui/base/window_open_disposition.h
+++ b/ui/base/window_open_disposition.h
@@ -28,8 +28,11 @@ enum class WindowOpenDisposition {
   NEW_PICTURE_IN_PICTURE,
   // Opens a link in a split view alongside the current tab.
   NEW_SPLIT_VIEW,
+  // Oa: an embedder's own split view, as ArcCore's value. Only its page
+  // context menu sends it, so Blink's NEW_SPLIT_VIEW stays a click's.
+  SPLIT_VIEW,
   // Update when adding a new disposition.
-  MAX_VALUE = NEW_SPLIT_VIEW,
+  MAX_VALUE = SPLIT_VIEW,
 };
 
 #endif  // UI_BASE_WINDOW_OPEN_DISPOSITION_H_
