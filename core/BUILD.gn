# OaCore: the engine side of Oa, linked into Chromium's framework by
# chromium/patches, which also exports OACoreMain.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("ad_blocker_mojom") {
  sources = [ "common/ad_blocker.mojom" ]
  public_deps = [ "//mojo/public/mojom/base" ]
}

source_set("oa") {
  sources = [
    "app/engine.mm",
    "browser/ad_blocker_service.cc",
    "browser/ad_blocker_service.h",
    "browser/autocomplete_impl.cc",
    "browser/browser_impl.cc",
    "browser/browser_impl.h",
    "browser/downloads_impl.cc",
    "browser/extensions_impl.cc",
    "browser/forwarding_web_contents_delegate.cc",
    "browser/forwarding_web_contents_delegate.h",
    "browser/history_impl.mm",
    "browser/image_handle.h",

    "browser/page_impl.h",
    "browser/page_impl.mm",
    "browser/preferences_impl.cc",
    "browser/profile_services.cc",
    "browser/profile_services.h",
    "browser/session_restoration.h",
    "browser/session_restoration.mm",
    "browser/site_settings_impl.cc",
    "browser/ui/browser_window_impl.h",
    "browser/ui/browser_window_impl.mm",
    "browser/ui/context_menu_impl.cc",
    "browser/ui/context_menu_impl.h",
    "browser/ui/extension_dialogs_impl.h",
    "browser/ui/extension_dialogs_impl.mm",
    "browser/ui/extensions_container_impl.h",
    "browser/ui/extensions_container_impl.mm",
    "browser/ui/javascript_dialog_impl.cc",
    "browser/ui/javascript_dialog_impl.h",
    "browser/ui/permission_prompt_impl.cc",
    "browser/ui/permission_prompt_impl.h",
    "browser/ui/sad_tab_impl.cc",
    "browser/ui/sad_tab_impl.h",
    "browser/ui/side_panel_ui_impl.cc",
    "browser/ui/side_panel_ui_impl.h",
    "browser/ui/video_overlay_window_impl.h",
    "browser/ui/video_overlay_window_impl.mm",
    "browser/window_browser.h",
    "browser/window_browser.mm",
    "common/ad_block_rules.cc",
    "common/ad_block_rules.h",
    "objc/OACore.h",
    "objc/OACore.mm",
    "public/ad_blocker.h",
    "public/autocomplete.h",
    "public/browser.h",
    "public/downloads.h",
    "public/engine.h",
    "public/extensions.h",
    "public/history.h",
    "public/page.h",
    "public/preferences.h",
    "public/profiles.h",
    "public/site_settings.h",
    "renderer/content_renderer_client.cc",
    "renderer/content_renderer_client.h",
  ]

  # ChromeMainDelegate's sources live in //chrome:chrome_dll, which links this
  # target; its headers aren't reachable through a GN dependency.
  check_includes = false

  deps = [
    ":ad_blocker_mojom",
    "//base",
    "//chrome/browser",
    "//chrome/browser:chrome_browser_application_mac",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ssl",
    "//chrome/common",
    "//chrome/common:buildflags",
    "//chrome/renderer",
    "//components/download/content/public",
    "//components/download/public/common:public",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/input",
    "//components/javascript_dialogs",
    "//components/keep_alive_registry",
    "//components/omnibox/browser",
    "//components/omnibox/common",
    "//components/permissions",
    "//components/search_engines",
    "//components/security_interstitials/core",
    "//components/security_state/core",
    "//components/sessions",
    "//components/subresource_filter/core/common",
    "//components/subresource_filter/tools/ruleset_converter:support",
    "//components/viz/common",
    "//components/web_modal",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/renderer",
    "//extensions/browser",
    "//extensions/common",
    "//ipc",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/media_session/public/mojom",
    "//services/network/public/cpp",
    "//skia",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//third_party/metrics_proto",
    "//ui/accelerated_widget_mac",
    "//ui/base",
    "//ui/compositor",
    "//ui/display/types",
    "//ui/gfx",
    "//ui/menus",
    "//url",
  ]

  frameworks = [
    "AppKit.framework",
    "QuartzCore.framework",
  ]
}
