# OaCore: the engine side of Oa, linked into Chromium's framework by
# chromium/patches, which also exports OACoreMain.
source_set("oa") {
  sources = [
    "app/engine.mm",
    "browser/browser_client.cc",
    "browser/browser_client.h",
    "browser/forwarding_web_contents_delegate.cc",
    "browser/forwarding_web_contents_delegate.h",
    "browser/page_impl.h",
    "browser/page_impl.mm",
    "browser/kept_address_throttle.cc",
    "browser/kept_address_throttle.h",
    "browser/profile_services.cc",
    "browser/profile_services.h",
    "browser/ui/browser_window_impl.h",
    "browser/ui/browser_window_impl.mm",
    "browser/ui/permission_prompt_impl.cc",
    "browser/ui/permission_prompt_impl.h",
    "browser/ui/side_panel_ui_impl.cc",
    "browser/ui/side_panel_ui_impl.h",
    "browser/window_browser.h",
    "browser/window_browser.mm",
    "objc/OACore.h",
    "objc/OACore.mm",
    "public/engine.h",
    "public/page.h",
  ]

  # ChromeMainDelegate's sources live in //chrome:chrome_dll, which links this
  # target; its headers aren't reachable through a GN dependency.
  check_includes = false

  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser:chrome_browser_application_mac",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//chrome/browser/ssl",
    "//chrome/common:buildflags",
    "//components/favicon/content",
    "//components/favicon/core",
    "//components/input",
    "//components/keep_alive_registry",
    "//components/permissions",
    "//components/security_interstitials/core",
    "//components/security_state/core",
    "//components/viz/common",
    "//components/web_modal",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//skia",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/gfx",
    "//url",
  ]

  frameworks = [ "AppKit.framework" ]
}
